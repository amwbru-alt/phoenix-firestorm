  "$defs": {
    "transform": {
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale",
        "space"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "rotation": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "w"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": -1.001,
              "maximum": 1.001
            },
            "y": {
              "type": "number",
              "minimum": -1.001,
              "maximum": 1.001
            },
            "z": {
              "type": "number",
              "minimum": -1.001,
              "maximum": 1.001
            },
            "w": {
              "type": "number",
              "minimum": -1.001,
              "maximum": 1.001
            }
          }
        },
        "scale": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "space": {
          "const": "region"
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "kind",
        "assetId",
        "version",
        "bounds"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "primitive",
            "mesh",
            "compatibility-primitive",
            "compatibility-mesh"
          ]
        },
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "bounds": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        }
      }
    },
    "visual_material": {
      "type": "object",
      "required": [
        "baseColor",
        "metallic",
        "roughness",
        "emissive",
        "baseColorTexture",
        "normalTexture",
        "materialAsset",
        "alphaMode",
        "alphaCutoff",
        "doubleSided"
      ],
      "additionalProperties": false,
      "properties": {
        "baseColor": {
          "type": "object",
          "required": [
            "r",
            "g",
            "b",
            "a"
          ],
          "additionalProperties": false,
          "properties": {
            "r": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "g": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "b": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "a": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emissive": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "baseColorTexture": {
          "type": "string",
          "format": "uuid"
        },
        "normalTexture": {
          "type": "string",
          "format": "uuid"
        },
        "materialAsset": {
          "type": "string",
          "format": "uuid"
        },
        "alphaMode": {
          "enum": [
            "opaque",
            "mask",
            "blend"
          ]
        },
        "alphaCutoff": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "doubleSided": {
          "type": "boolean"
        }
      }
    },
    "physical_material": {
      "type": "object",
      "required": [
        "density",
        "friction",
        "restitution",
        "stiffness",
        "damping",
        "thickness",
        "moistureAbsorption",
        "thermalConductivity"
      ],
      "additionalProperties": false,
      "properties": {
        "density": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 10000000.0
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stiffness": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000000000000.0
        },
        "damping": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "thickness": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 100
        },
        "moistureAbsorption": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "thermalConductivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0
        }
      }
    },
    "collider": {
      "type": "object",
      "required": [
        "kind",
        "size",
        "assetId",
        "layer",
        "contactMask",
        "continuous",
        "trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "box",
            "sphere",
            "capsule",
            "convex",
            "triangle",
            "sdf"
          ]
        },
        "size": {
