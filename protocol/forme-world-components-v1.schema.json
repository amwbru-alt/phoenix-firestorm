        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "contactMask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "continuous": {
          "type": "boolean"
        },
        "trigger": {
          "type": "boolean"
        }
      }
    },
    "rigid_body": {
      "type": "object",
      "required": [
        "mode",
        "mass",
        "velocity",
        "angularVelocity"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "static",
            "dynamic",
            "kinematic",
            "deformable",
            "cloth",
            "hair",
            "articulated",
            "fluid",
            "character"
          ]
        },
        "mass": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000.0
        },
        "velocity": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "angularVelocity": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "gravityModifier": {
          "type": "number",
          "minimum": -1,
          "maximum": 28
        },
        "massPending": {
          "type": "boolean"
        }
      }
    },
    "deformable_body": {
      "type": "object",
      "required": [
        "topologyAsset",
        "mass",
        "compliance",
        "damping",
        "maximumStrain",
        "solverIterations",
        "selfCollision"
      ],
      "additionalProperties": false,
      "properties": {
        "topologyAsset": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "mass": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000000.0
        },
        "compliance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0
        },
        "damping": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "maximumStrain": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "solverIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "selfCollision": {
          "type": "boolean"
        }
      }
    },
    "skeleton": {
      "type": "object",
      "required": [
        "bones"
      ],
      "additionalProperties": false,
      "properties": {
        "bones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "parent",
              "translation",
              "rotation",
              "scale"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "parent": {
                "type": "integer",
                "minimum": -1,
                "maximum": 255
              },
              "translation": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              },
              "rotation": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z",
                  "w"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1.001,
                    "maximum": 1.001
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1.001,
                    "maximum": 1.001
                  },
                  "z": {
                    "type": "number",
                    "minimum": -1.001,
                    "maximum": 1.001
                  },
                  "w": {
                    "type": "number",
                    "minimum": -1.001,
                    "maximum": 1.001
                  }
                }
              },
              "scale": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "maxItems": 256
        }
      }
    },
    "animation": {
      "type": "object",
      "required": [
        "layers"
      ],
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "clipAsset",
              "channel",
              "weight",
              "speed",
              "loop"
            ],
            "additionalProperties": false,
            "properties": {
              "clipAsset": {
                "type": "string",
                "format": "uuid",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "channel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "speed": {
                "type": "number",
                "minimum": -16,
                "maximum": 16
              },
              "loop": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 16
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": [
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "verb",
              "distance",
              "targetEntity",
              "permission"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "verb": {
                "enum": [
                  "use",
                  "sit",
                  "lie",
                  "open",
                  "close",
                  "grab",
                  "release",
                  "touch"
