              },
              "permission": {
                "enum": [
                  "everyone",
                  "owner",
                  "group",
                  "creator"
                ]
              }
            }
          },
          "maxItems": 32
        }
      }
    },
    "fluid_interaction": {
      "type": "object",
      "required": [
        "displacedVolume",
        "linearDrag",
