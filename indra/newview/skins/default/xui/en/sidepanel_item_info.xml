<?xml version='1.0' encoding='utf-8'?>
<panel follows="all" height="662" layout="topleft" name="item properties" title="Item Profile" width="468">
  <panel.string name="loading_experience">
    (loading)
  </panel.string>
  <panel.string name="unknown">
    (unknown)
  </panel.string>
  <panel.string name="unknown_multiple">
    (unknown / multiple)
  </panel.string>
  <panel.string name="public">
    (public)
  </panel.string>
  <panel.string name="you_can">
    You can:
  </panel.string>
  <panel.string name="owner_can">
    Owner can:
  </panel.string>
  <panel.string name="acquiredDateAMPM">
    [wkday,datetime,slt] [mth,datetime,slt] [day,datetime,slt] [year,datetime,slt], [hour12,datetime,slt]:[min,datetime,slt]:[second,datetime,slt] [ampm,datetime,slt]
  </panel.string>
  <panel.string name="acquiredDate">
    [wkday,datetime,slt] [mth,datetime,slt] [day,datetime,slt] [year,datetime,slt], [hour,datetime,slt]:[min,datetime,slt]:[second,datetime,slt]
  </panel.string>
  <panel.string name="origin_inventory">
    (Inventory)
  </panel.string>
  <panel.string name="origin_inworld">
    (Inworld)
  </panel.string>
  <scroll_container name="item_scroll_container" layout="topleft" left="0" top="0" right="-1" bottom="-1" follows="all" opaque="false" reserve_scroll_corner="false">
    <layout_stack animate="false" name="main_stack" layout="topleft" follows="left|right|top" orientation="vertical" left="0" top="0" width="452" height="760">
      <layout_panel auto_resize="false" name="layout_item_name" layout="topleft" follows="all" height="42">
        <icon follows="top|left" height="22" image_name="Inv_Object" layout="topleft" mouse_opaque="true" name="item_type_icon" width="22" left="10" top="12" />
        <line_editor border_style="line" border_thickness="1" follows="left|top|right" layout="topleft" height="34" max_length_bytes="63" name="LabelItemName" tool_tip="The name is limited to 63 characters. Longer prim names are cut short. Names can only consist of printable characters found in the ASCII-7 (non-extended) character set, with the exception of the vertical bar/pipe '|'." left="44" top="6" width="396" />
      </layout_panel>
      <layout_panel auto_resize="false" name="layout_item_details" layout="topleft" follows="all" height="164" background_visible="true" background_opaque="true" bg_opaque_image="Forme_UI_Card" bg_opaque_color="White">
        <thumbnail name="item_thumbnail" fallback_image="Thumbnail_Fallback" follows="top|left" layout="topleft" height="128" width="128" left="10" top="10" />
        <text type="string" length="1" follows="left|top" height="22" layout="topleft" name="LabelOwnerTitle" width="86" left="154" top="12">
        Owner:
      </text>
        <text type="string" font="SansSerifSmall" follows="left|right|top" layout="topleft" height="24" width="278" name="LabelOwnerName" use_ellipses="true" translate="false" left="154" top="36">
TestString PleaseIgnore
      </text>
        <text type="string" length="1" follows="left|top" height="22" layout="topleft" name="LabelCreatorTitle" width="86" left="154" top="68">
        Creator:
      </text>
        <text type="string" font="SansSerifSmall" follows="left|right|top" layout="topleft" width="278" height="24" name="LabelCreatorName" use_ellipses="true" translate="false" left="154" top="92">
TestString PleaseIgnore
      </text>
        <text type="string" length="1" follows="left|top" height="20" layout="topleft" name="LabelAcquiredTitle" width="86" left="154" top="122">
        Acquired:
      </text>
        <text type="string" length="1" follows="left|top|right" height="28" layout="topleft" name="LabelAcquiredDate" width="188" left="244" top="122">
        00/00/00
      </text>
        <button follows="left|top" height="24" label="Image..." layout="topleft" name="change_thumbnail_btn" width="120" left="14" top="140" />
      </layout_panel>
      <layout_panel auto_resize="false" name="layout_item_description" layout="topleft" follows="all" height="130" background_visible="true" background_opaque="true" bg_opaque_image="Forme_UI_Card" bg_opaque_color="White">
        <text type="string" length="1" follows="left|top" height="22" layout="topleft" name="LabelItemDescTitle" width="120" left="12" top="8">
        Description:
      </text>
        <text_editor prevalidator="ascii_printable_no_pipe" commit_on_focus_lost="true" word_wrap="true" use_ellipses="false" follows="all" layout="topleft" height="64" max_length="127" name="LabelItemDesc" tool_tip="When people have 'Hover Tips on All Objects' selected in the viewer's settings, they'll see the object description pop-up for any object under their mouse pointer. The prim description is limited to 127 bytes any string longer then that will be truncated." left="12" top="34" width="424" />
        <text type="string" length="1" follows="left|top" height="20" layout="topleft" name="LabelItemExperienceTitle" width="100" visible="true" left="12" top="104">
          Experience:
        </text>
        <text type="string" length="1" follows="left|top|right" height="20" layout="topleft" name="LabelItemExperience" width="312" visible="true" left="120" top="104" />
      </layout_panel>
      <layout_panel auto_resize="false" name="layout_item_permissions_sale" layout="topleft" follows="all" height="300" background_visible="true" background_opaque="true" bg_opaque_image="Forme_UI_Card" bg_opaque_color="White">
        <view_border bevel_style="none" height="0" layout="topleft" left="5" right="-5" name="cost_text_border" top="1" />
        <text type="string" length="1" height="22" follows="left|top" layout="topleft" name="perm_modify" width="424" left="12" top="8">
        Permissions
      </text>
        <text type="string" length="1" height="22" follows="left|top" layout="topleft" name="you_perm_modify" width="195" left="12" top="40">
        You can:
      </text>
        <check_box height="24" label="Modify" layout="topleft" name="CheckOwnerModify" width="196" left="12" top="70" />
        <check_box height="24" label="Copy" layout="topleft" name="CheckOwnerCopy" width="196" left="12" top="98" />
        <check_box height="24" label="Transfer" layout="topleft" name="CheckOwnerTransfer" width="196" left="12" top="126" />
        <text type="string" length="1" follows="left|top" height="22" layout="topleft" name="AnyoneLabel" width="100" left="12" top="164">
        Anyone:
      </text>
        <check_box height="24" label="Copy" layout="topleft" name="CheckEveryoneCopy" tool_tip="Anyone can take a copy of the object. Object and all of its contents must be copy and transfer permissive." width="100" left="116" top="162" />
        <text type="string" length="1" follows="left|top" height="22" layout="topleft" name="GroupLabel" width="82" left="230" top="164">
        Group:
      </text>
        <check_box height="24" label="Share" layout="topleft" name="CheckShareWithGroup" tool_tip="Allow all members of the set group to share your modify permissions for this object. You must Deed to enable role restrictions." width="122" left="314" top="162" />
        <text type="string" length="1" follows="left|top" height="22" layout="topleft" name="NextOwnerLabel" width="200" word_wrap="true" left="230" top="40">
        Next owner:
      </text>
        <check_box height="24" label="Modify" layout="topleft" name="CheckNextOwnerModify" tool_tip="Next owner can edit properties like item name or scale of this object." width="196" left="230" top="70" />
        <check_box height="24" label="Copy" layout="topleft" name="CheckNextOwnerCopy" tool_tip="Next owner can make unlimited copies of this object. Copies maintain creator information, and can never be more permissive than the item being copied." width="196" left="230" top="98" />
        <check_box height="24" label="Transfer" layout="topleft" name="CheckNextOwnerTransfer" tool_tip="Next owner can give away or resell this object." width="196" left="230" top="126" />
        <view_border bevel_style="none" height="0" layout="topleft" left="5" right="-5" name="cost_text_border" top_pad="9" />
        <check_box height="26" label="For Sale" layout="topleft" name="CheckPurchase" width="170" tool_tip="Lets people buy this object, its content or it copy inworld for specified price." left="12" top="204" />
        <combo_box height="32" layout="topleft" follows="left|top" name="ComboBoxSaleType" width="204" tool_tip="Select whether purchaser will receive a copy, copy of the content or item itself." left="12" top="244">
          <combo_box.item name="Copy" label="Copy" value="2" />
          <combo_box.item name="Contents" label="Contents" value="3" />
          <combo_box.item name="Original" label="Original" value="1" />
        </combo_box>
        <spinner follows="left|top" decimal_digits="0" increment="1" name="Edit Cost" label="Price: L$" label_width="75" width="206" min_val="0" height="32" max_val="999999999" tool_tip="Object cost." layout="topleft" left="230" top="244" />
      </layout_panel>
      <layout_panel auto_resize="false" name="layout_debug_permissions" layout="topleft" follows="all" height="54">
        <text type="string" length="1" follows="left|top" height="10" layout="topleft" left="10" name="BaseMaskDebug" text_color="White" top="2" width="130">
          B:
        </text>
        <text type="string" length="1" follows="left|top" height="10" layout="topleft" left_delta="60" name="OwnerMaskDebug" text_color="White" top_delta="0" width="270">
          O:
        </text>
        <text type="string" length="1" follows="left|top" height="10" layout="topleft" left_delta="60" name="GroupMaskDebug" text_color="White" top_delta="0" width="210">
          G:
        </text>
        <text type="string" length="1" follows="left|top" height="10" layout="topleft" left_delta="60" name="EveryoneMaskDebug" text_color="White" top_delta="0" width="150">
          E:
        </text>
        <text type="string" length="1" follows="left|top" height="10" layout="topleft" left_delta="60" name="NextMaskDebug" text_color="White" top_delta="0" width="90">
          N:
        </text>
      </layout_panel>
    </layout_stack>
  </scroll_container>
</panel>
