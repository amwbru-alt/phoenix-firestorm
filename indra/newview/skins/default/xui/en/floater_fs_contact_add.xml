<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 height="190"
 width="380"
 layout="topleft"
 positioning="centered"
 legacy_header_height="0"
 can_resize="false"
 name="floater_fs_add_contact"
 title="Add to Contact Set..." header_height="44" header_vpad="10" header_icon="Forme_UI_Window" bg_opaque_image="Forme_Round_Window" bg_alpha_image="Forme_Round_WindowInactive" bg_opaque_color="White" bg_alpha_color="White" header_font="SansSerif" header_font.size="WMapRegion" header_font.style="BOLD">
	<floater.string name="no_sets">
		No contact sets available.
	</floater.string>
	<floater.string name="text_add_single">
		Please select which contact set to add [NAME] to:
	</floater.string>
	<floater.string name="text_add_multiple">
		Please select which contact set to add [COUNT] avatars to:
	</floater.string>
	<floater.string name="title_add">
		Add to Contact Set...
	</floater.string>
	<floater.string name="button_add">
		Add to set
	</floater.string>
	<floater.string name="title_move">
		Move to Contact Set...
	</floater.string>
	<floater.string name="button_move">
		Move to Set
	</floater.string>
	<text
	 type="string"
	 follows="left|top"
	 height="42"
	 layout="topleft"
	 left="20"
	 name="textfield"
	 word_wrap="true"
	 top="16"
	 right="-20">
	</text>
	<combo_box
	 follows="left|top"
	 layout="topleft"
	 height="30"
	 allow_text_entry="false"
	 top_pad="10"
	 left="20"
	 name="contact_sets"
	 width="300"/>
    <button
     left_pad="8"
     top_delta="0"
     follows="top|right"
     layout="topleft"
     height="30"
	 image_overlay="AddItem_Off"
     name="add_set_btn"
     width="24" />
	<button
	 left="20"
	 top_pad="18"
	 follows="top|right"
	 layout="topleft"
	 height="28"
	 label="Add to set"
	 name="add_btn"
	 width="150" />
	<button
	 left_pad="10"
	 top_delta="0"
	 follows="top|right"
	 layout="topleft"
	 height="22"
	 label="Cancel"
	 name="cancel_btn"
	 width="130" />
</floater>
