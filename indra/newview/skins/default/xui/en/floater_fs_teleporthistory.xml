<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 positioning="centered"
 legacy_header_height="0"
 can_resize="true"
 height="475"
 layout="topleft"
 name="floater_tphistory"

 save_rect="true"
 reuse_instance="true"
 title="Teleport History"
 min_height="200"
 min_width="460"
 width="480" header_height="44" header_vpad="10" header_icon="Forme_UI_Window" bg_opaque_image="Forme_Round_Window" bg_alpha_image="Forme_Round_WindowInactive" bg_opaque_color="White" bg_alpha_color="White" header_font="SansSerif" header_font.size="WMapRegion" header_font.style="BOLD">
	<filter_editor
	 follows="left|top|right"
	 font="SansSerifSmall"
	 height="23"
	 layout="topleft"
	 left="16"
	 right="-80"
	 label="Filter Teleport History"
	 max_length_chars="300"
	 name="Filter"
	 top="23"
	 width="380"/>

	<menu_button
	 follows="top|right"
	 tool_tip="Show options"
	 height="23"
	 image_hover_unselected="Toolbar_Middle_Over"
	 image_overlay="OptionsMenu_Off"
	 image_selected="Toolbar_Middle_Selected"
	 image_unselected="Toolbar_Middle_Off"
	 menu_position="bottomleft"
	 layout="topleft"
	 right="-38"
	 name="options_gear_btn"
	 top_delta="0"
	 width="31" />
	<menu_button
	 follows="top|right"
	 tool_tip="Show sorting options"
	 height="23"
	 image_hover_unselected="Toolbar_Middle_Over"
	 image_overlay="Conv_toolbar_sort"
	 image_selected="Toolbar_Middle_Selected"
	 image_unselected="Toolbar_Middle_Off"
	 menu_position="bottomleft"
	 layout="topleft"
	 right="-5"
	 name="sorting_menu_btn"
	 top_delta="0"
	 width="31" />

	<panel
	 top="46"
	 left="16"
	 right="-16"
	 bottom="-48"
	 height="400"
	 name="history_placeholder"
	 layout="topleft"
	 follows="all"/>

	<panel
	 bottom="-12"
	 follows="bottom|left|right"
	 height="32"
	 layout="topleft"
	 left="0"
	 name="button_panel"
	 width="448">
		<layout_stack
		 follows="bottom|left|right"
		 height="23"
		 layout="topleft"
		 mouse_opaque="false"
		 name="bottom_bar_ls0"
		 left="0"
		 orientation="horizontal"
		 top="0"
		 width="448">

			<layout_panel
			 follows="bottom|left|right"
			 height="23"
			 layout="bottomleft"
			 left="0"
			 mouse_opaque="false"
			 name="show_lm_panel"
			 auto_resize="true"
			 width="448">

				<layout_stack
				 follows="bottom|left|right"
				 height="23"
				 layout="topleft"
				 mouse_opaque="false"
				 name="bottom_bar_ls1"
				 left="0"
				 orientation="horizontal"
				 top="0"
				 width="448">
					<layout_panel
					 follows="bottom|left|right"
					 height="23"
					 layout="bottomleft"
					 left="0"
					 mouse_opaque="false"
					 name="teleport_btn_lp"
					 auto_resize="true"
					 width="132">
						<button
						 follows="bottom|left|right"
						 height="30"
						 label="Teleport"
						 layout="topleft"
						 left="1"
						 name="teleport_btn"
						 tool_tip="Teleport to the selected area"
						 top="0"
						 width="130" />
					</layout_panel>

					<layout_panel
					 follows="bottom|left|right"
					 height="23"
					 layout="bottomleft"
					 left_pad="8"
					 mouse_opaque="false"
					 name="chat_btn_lp"
					 auto_resize="true"
					 width="112">
						<button
						 follows="bottom|left|right"
						 height="30"
						 label="Map"
						 layout="topleft"
						 left="1"
						 name="map_btn"
						 tool_tip="Show the corresponding area on the World Map"
						 top="0"
						 width="110"/>
					</layout_panel>

					<layout_panel
					 follows="bottom|left|right"
					 height="23"
					 layout="bottomleft"
					 left_pad="8"
					 mouse_opaque="false"
					 name="profile_btn_lp"
					 auto_resize="true"
					 width="172">
						<button
						 follows="bottom|left|right"
						 height="30"
						 label="Show Profile"
						 layout="topleft"
						 left="1"
						 name="profile_btn"
						 tool_tip="Show the profile of this location"
						 top="0"
						 width="170" />
					</layout_panel>
				</layout_stack>
			</layout_panel>
		</layout_stack>	
	</panel>
</floater>
