<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 positioning="cascading"
 legacy_header_height="0"
 can_resize="true"
 height="460"
 layout="topleft"
 min_height="380"
 min_width="500"
 name="avatarpicker"

 save_rect="true"
 title="Choose Resident"
 width="560" header_height="44" header_vpad="10" header_icon="Forme_UI_Window" bg_opaque_image="Forme_Round_Window" bg_alpha_image="Forme_Round_WindowInactive" bg_opaque_color="White" bg_alpha_color="White" header_font="SansSerif" header_font.size="WMapRegion" header_font.style="BOLD">
    <floater.string
     name="not_found">
        &apos;[TEXT]&apos; not found
    </floater.string>
    <floater.string
     name="not_found_text">
        Resident wasn't found.
    </floater.string>
    <floater.string
     name="no_one_near">
        No one near
    </floater.string>
    <floater.string
     name="no_results">
        No results
    </floater.string>
    <floater.string
     name="searching">
        Searching...
    </floater.string>
    <!-- For multiple person selection, use "Select" and "Close" 
      instead of "OK" and "Cancel" because "Cancel" still keeps the ones 
      you have already selected.  The code will show the appropriate
      set of buttons. -->
    <string name="Select">Select</string>
    <string name="Close">Close</string>
    <tab_container
     follows="all"
     height="380"
     layout="topleft"
     left="16"
     name="ResidentChooserTabs"
     tab_position="top"
     top="54"
     right="-16">
        <panel
         height="340"
         label="Search"
         layout="topleft"
         left="0"
         follows="all"
         name="SearchPanel"
         top="0"
         right="-4">
            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="10"
             name="InstructSearchResidentName"
             top="12"
             width="480">
                Type part of a person&apos;s name:
            </text>
            <line_editor
             bevel_style="none"
             border_style="line"
             commit_on_focus_lost="false"
             follows="left|top|right"
             height="23"
             left_delta="0"
             name="Edit"
             top="34"
             width="420" />
            <button
             follows="top|right"
             height="23"
             label="Go"
             label_selected="Go"
             layout="topleft"
             left_pad="5"
             name="Find"
             width="64" />
          <fs_scroll_list
            draw_heading="true" 
           follows="all"
           height="270"
           layout="topleft"
           left="0"
           name="SearchResults"
           top="68"
           right="-4">
            <columns
              label="Name"
              name="name"
              width="150" />
            <columns
              label="Username"
              name="username"
              width="150" />
          </fs_scroll_list>
        </panel>
        <panel
         height="340"
         label="Friends"
         layout="topleft"
         left="0"
         follows="all"
         name="FriendsPanel"
         top="0"
         right="-4">
            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="10"
             name="InstructSelectFriend"
             top="12"
             width="440">
                Select a person:
            </text>
            <button
             follows="top|right"
             layout="topleft"
             right="-8"
             top ="8"
             height="20"
             width="20"
             name="RefreshFriends"
             image_overlay="Refresh_Off">
             <button.commit_callback 
              function="Refresh.FriendList"/>
            </button>
            <fs_scroll_list
             draw_heading="true"
             follows="all"
             height="292"
             layout="topleft"
             left="0"
             name="Friends"
             sort_column="0"
             top="38"
             right="-4">
            <columns
              label="Name"
              name="name"
              width="150" />
            <columns
              label="Username"
              name="username"
              width="150" />
            </fs_scroll_list>
        </panel>

        <panel
         height="340"
         label="Near Me"
         layout="topleft"
         left="0"
         follows="all"
         name="NearMePanel"
         top="0"
         right="-4">
            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="10"
             name="InstructSelectResident"
             top="10"
             width="440">
                Select a person nearby:
            </text>
            <slider
             control_name="NearMeRange"
             decimal_digits="0"
             follows="left|top"
             height="18"
             increment="1"
             initial_value="20"
             label="Range"
             layout="topleft"
             left="10"
             max_val="130"
             min_val="5"
             name="near_me_range"
             top="34"
             width="300" />
            <text
             type="string"
             length="1"
             follows="left|top"
             height="18"
             layout="topleft"
             left_pad="0"
             name="meters"
             top="36"
             width="70">
                Meters
            </text>
            <button
             follows="top|left"
             layout="topleft"
             left_pad="0"
             height="28"
             width="28"
             name="Refresh"
             top="30"
             image_overlay="Refresh_Off" />
          <fs_scroll_list
             draw_heading="true"
             follows="all"
             height="250"
             layout="topleft"
             left="0"
             name="NearMe"
             sort_column="0"
             top="78"
             right="-4">
            <columns
              label="Name"
              name="name"
              width="150" />
            <columns
              label="Username"
              name="username"
              width="150" />
          </fs_scroll_list>
        </panel>

        <panel
         height="340"
         label="Search by UUID"
         layout="topleft"
         left="0"
         follows="all"
         name="SearchPanelUUID"
         top="0"
         right="-4">
            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="10"
             name="SearchByUUIDLabel"
             top="12"
             width="440">
                Enter a person&apos;s UUID:
            </text>
            <line_editor
             bevel_style="none"
             border_style="line"
             commit_on_focus_lost="false"
             follows="left|top|right"
             height="23"
             left_delta="0"
             name="EditUUID"
             top="34"
             width="420" />
            <button
             follows="top|right"
             height="23"
             label="Go"
             label_selected="Go"
             layout="topleft"
             left_pad="5"
             name="FindUUID"
             width="64" />
            <fs_scroll_list
             draw_heading="true" 
             follows="all"
             height="270"
             layout="topleft"
             left="0"
             name="SearchResultsUUID"
             top="68"
             right="-4">
             <columns
              label="Name"
              name="nameUUID"
              width="150" />
             <columns
              label="Username"
              name="usernameUUID"
              width="150" />
          </fs_scroll_list>
        </panel>

        <panel
         height="340"
         label="Contact Sets"
         layout="topleft"
         left="0"
         follows="all"
         name="ContactSetsPanel"
         top="0"
         right="-4">
            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="10"
             name="SelectContactSetLabel"
             top="12"
             width="440">
                Select a contact set:
            </text>
            <combo_box
             follows="left|top|right"
             height="20"
             layout="topleft"
             left_delta="0"
             name="ContactSetSelector"
             top="38"
             width="440"/>
        </panel>
    </tab_container>
    <button
     follows="left|bottom"
     height="28"
     label="OK"
     label_selected="OK"
     name="ok_btn"
     bottom="-42"
     right="-124"
     width="100" />
    <button
     follows="right|bottom"
     height="28"
     label="Cancel"
     label_selected="Cancel"
     name="cancel_btn"
     width="100"
     right="-16"
     bottom="-42" />
</floater>
