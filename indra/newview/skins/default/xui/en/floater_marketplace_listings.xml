<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<floater
  title="Marketplace Listings"
  name="floater_marketplace_listings"
 
  positioning="cascading"
  width="440"
  height="560"
  min_width="380"
  min_height="420"
  can_close="true"
  can_resize="true"
  save_rect="true"
  save_visibility="false"
  reuse_instance="true" forme_creator_only="true" header_height="44" header_vpad="10" header_icon="Forme_UI_Pin" bg_opaque_image="Forme_Round_Window" bg_alpha_image="Forme_Round_WindowInactive" bg_opaque_color="White" bg_alpha_color="White" header_font="SansSerif" header_font.size="WMapRegion" header_font.style="BOLD" legacy_header_height="0">
  <panel
    name="marketplace_listings_panel"
    follows="all"
    layout="topleft"
    left="0"
    top="0" right="-0">
    <panel
      name="background_panel"
      follows="all"
      left="10"
      top="0"
      bg_opaque_color="InventoryBackgroundColor" right="-10" bottom="-0">
      <panel
        name="marketplace_listings_inventory_placeholder_panel"
        follows="all"
        layout="topleft"
        top="0"
        left="0"
        bg_opaque_color="InventoryBackgroundColor" right="-0" bottom="-0">
        <text
          name="marketplace_listings_inventory_placeholder_title"
          type="string"
          follows="top|left|right"
          layout="topleft"
          top="10"
          left="0"
          height="25"
          wrap="true"
          halign="center"
          font="SansSerifBold" right="-10">
            Loading...
        </text>
        <text
          name="marketplace_listings_inventory_placeholder_text"
          type="string"
          follows="top|left|right"
          layout="topleft"
          top="35"
          left="0"
          height="130"
          wrap="true"
          halign="left"  right="-0"/>
      </panel>
      <panel
        name="panel_marketplace_listing"
        filename="panel_marketplace_listings.xml"
        class="llpanelmarketplacelistings"
        top="0"
        follows="all" right="-0" bottom="-0"/>
      </panel>
    <panel
      name="marketplace_panel_status"
      follows="bottom|left|right"
      layout="topleft"
      left="10"
      height="20" right="-10" bottom="-0">
      <text
        name="marketplace_status"
        type="string"
        follows="bottom|left|right"
        layout="topleft"
        top="0"
        left="5"
        height="20"
        wrap="true"
        halign="left"
        valign="center"
        font="SansSerif" right="-5"/>
    </panel>
    <layout_stack name="initialization_progress_indicator" orientation="vertical" left="0" top="0" follows="all" visible="false" right="-0" bottom="-0">
      <layout_panel />
      <layout_panel height="24" auto_resize="false">
        <layout_stack orientation="horizontal" left="0" height="24" top="0" follows="all" right="-0">
          <layout_panel width="0" />
          <layout_panel width="24" auto_resize="false">
            <loading_indicator
                height="24"
                layout="topleft"
                left="0"
                top="0"
                width="24" />
          </layout_panel>
          <layout_panel width="0" />
        </layout_stack>
      </layout_panel>
      <layout_panel />
    </layout_stack>
  </panel>
</floater>
