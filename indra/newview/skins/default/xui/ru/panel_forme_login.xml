<?xml version="1.0" encoding="utf-8"?>
<panel name="panel_login">
  <panel name="login_widgets">
    <panel name="login">
      <text name="forme_login_title">Вход в ForMe.World</text>
      <text name="username_text">Имя аватара</text>
      <text name="password_text">Пароль</text>
      <button name="remove_user_btn" tool_tip="Удалить сохранённое имя"/>
      <button name="password_show_btn" tool_tip="Показать пароль"/>
      <button name="password_hide_btn" tool_tip="Скрыть пароль"/>
      <check_box name="remember_username_check" label="Запомнить имя аватара"/>
      <check_box name="remember_check" label="Запомнить пароль"/>
    </panel>
    <layout_stack name="forme_start_stack">
      <layout_panel name="start_location_panel">
        <text name="start_location_text">Начальная локация</text>
        <combo_box name="start_location_combo">
          <combo_box.item name="MyLastLocation" label="Последнее место"/>
          <combo_box.item name="MyHome" label="Дом"/>
          <combo_box.item name="Typeregionname" label="Введите название региона"/>
        </combo_box>
      </layout_panel>
    </layout_stack>
    <button name="connect_btn" label="Войти в мир"/>
    <text name="create_new_account_text">Создать аккаунт</text>
  </panel>
  <panel name="forme_welcome_hub">
    <text name="forme_hub_eyebrow">ТВОЙ МИР — ТВОИ ПРАВИЛА</text>
    <text name="forme_hub_title">Место, где можно исследовать и быть собой</text>
    <text name="forme_hub_intro">Открывай новые места, знакомься с людьми и создавай собственную историю в мире его жителей.</text>
    <panel name="forme_hub_explore_card">
      <text name="forme_hub_explore_title">Исследуй</text>
      <text name="forme_hub_explore_copy">Открывай регионы, интересные места и новые впечатления.</text>
    </panel>
    <panel name="forme_hub_connect_card">
      <text name="forme_hub_connect_title">Общайся</text>
      <text name="forme_hub_connect_copy">Знакомься с жителями и создавай сообщества.</text>
    </panel>
    <panel name="forme_hub_create_card">
      <text name="forme_hub_create_title">Создавай</text>
      <text name="forme_hub_create_copy">Строй, выражай себя и делись своими работами.</text>
    </panel>
    <text name="forme_hub_footer">Один мир. Много способов найти своё место.</text>
  </panel>
  <text name="forme_coast_caption">Лазурный берег</text>
</panel>
